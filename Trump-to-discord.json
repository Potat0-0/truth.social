      "typeVersion": 1,
      "position": [
        12496,
        18352
      ],
      "id": "3f68f9c8-29f7-481a-bcae-708e82c72c5d",
      "name": "No Operation, do nothing"
    },
    {
      "parameters": {
        "jsCode": "let maxId = \"0\";\n\nfor (const item of $input.all()) {\n  // Handle the case where BrightData returns the array of statuses directly\n  const posts = Array.isArray(item.json) ? item.json : [item.json];\n  \n  for (const post of posts) {\n    if (post && post.id) {\n      if (BigInt(post.id) > BigInt(maxId)) {\n        maxId = post.id.toString();\n      }\n    }\n  }\n}\n\nreturn [{ json: { highest_id: maxId } }];"
      },
      "id": "b139eac4-1cba-4b0e-81d1-01437c841c66",
      "name": "Calculate Max ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        12496,
        17968
      ],
      "notes": "Finds the highest post ID in the batch safely before storing it."
    },
