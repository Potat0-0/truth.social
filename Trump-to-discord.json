        "bodyParametersJson": "={\n  \"zone\": \"fetch_truths\",\n  \"url\": \"https://truthsocial.com/api/v1/accounts/107780257626128497/statuses?limit=20&exclude_replies=true{{ $json.last_id ? '&since_id=' + $json.last_id : '' }}\",\n  \"format\": \"raw\"\n}"
